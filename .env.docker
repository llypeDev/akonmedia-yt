# Defaults for `docker compose`. Copy to .env and change the secret before
# exposing the stack to the internet.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-before-you-deploy-this-anywhere
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://web:8000
SERVE_MEDIA=True

# Cookies are only marked Secure when the stack is behind TLS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

POSTGRES_HOST=db
POSTGRES_PORT=5432
# The database service reads these too, from .env only: change them there,
# before the first start.
POSTGRES_DB=qqplay
POSTGRES_USER=qqplay
POSTGRES_PASSWORD=qqplay

REDIS_URL=redis://redis:6379/1

# Live streaming. The ingest server (the "live" service) and the portal share
# this secret: change it in your .env before exposing the stack.
LIVE_HOOK_SECRET=change-this-live-hook-secret
# What encoders such as OBS connect to, and where viewers' browsers fetch the
# HLS. Use your public host name (and HTTPS for the HLS) in production.
LIVE_RTMP_URL=rtmp://localhost:1935/live
LIVE_HLS_URL=http://localhost:8080/hls
LIVE_CONTROL_URL=http://live:8081/control
LIVE_RECORDINGS_DIR=/app/live/recordings
# Streams from a browser are published from the web container to this address.
LIVE_RTMP_INTERNAL_URL=rtmp://live:1935/live
LIVE_BROWSER_DIR=/app/live/browser
