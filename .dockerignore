# Paths are anchored with a leading slash: an unanchored "media" would also
# drop apps/media from the build context, and the application would not start.
/.git
/.gitignore
/.venv
/.uvcache

**/__pycache__
**/*.pyc
*.sqlite3
/db.sqlite3

# runtime data and local build artefacts
/media
/staticfiles
/.render
/.build
/.demo-import
/.test-media
/.test-import

# editors and OS
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db

# documentation not needed inside the image
/README.md
/OPERATIONS.md

# screenshots for the README
/docs
/.env
/.live
/deploy
