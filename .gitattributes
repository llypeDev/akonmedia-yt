# Normalise line endings in the repository, whatever the developer's OS.
* text=auto eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.pdf binary
*.zip binary
