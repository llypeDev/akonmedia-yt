# Copy to .env and adjust. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev

SECRET_KEY=change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

PORTAL_NAME=AkonMedia
PORTAL_DESCRIPTION=
SITE_URL=http://localhost:8000

# Leave POSTGRES_HOST empty to use SQLite.
POSTGRES_HOST=
POSTGRES_DB=akonmedia
POSTGRES_USER=akonmedia
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_URL=
CELERY_BROKER_URL=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Interface language for visitors who have not picked one: pt-br or en.
LANGUAGE_CODE=pt-br
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Live streaming (see "Lives" in the README). The ingest server and the portal
# share LIVE_HOOK_SECRET; while it is empty nobody can go on air.
LIVE_HOOK_SECRET=
# What encoders such as OBS connect to, and where browsers fetch the HLS.
LIVE_RTMP_URL=rtmp://localhost:1935/live
LIVE_HLS_URL=http://localhost:8080/hls
# The ingest server's internal control endpoint (never expose it publicly).
LIVE_CONTROL_URL=http://localhost:8081/control
# Where this process sees the ingest server's recordings.
LIVE_RECORDINGS_DIR=
# Seconds to wait for a dropped encoder before the live ends by itself.
LIVE_RECONNECT_GRACE_SECONDS=120
# Streaming from a browser: where this process publishes (the ingest server as
# seen from here; defaults to LIVE_RTMP_URL) and its working folder.
LIVE_RTMP_INTERNAL_URL=
LIVE_BROWSER_DIR=
