msgstr "HLS · nativo"

#. Translators: stats overlay, Engine row: the original file, downloaded
#. progressively.
#: static/js/player.js:2212
msgid "Progressive"
msgstr "Progressivo"

#. Translators: stats overlay, Resolution row for sound-only media.
#: static/js/player.js:2218
msgid "audio only"
msgstr "somente áudio"

#. Translators: stats overlay, Level row; %(level)s is e.g. "720p · 2.93
#. Mbps", chosen automatically.
#: static/js/player.js:2226
msgid "%(level)s (auto)"
msgstr "%(level)s (automático)"

#. Translators: stats overlay, Level row; %(level)s is e.g. "720p · 2.93
#. Mbps", chosen by the viewer.
#: static/js/player.js:2228
msgid "%(level)s (manual)"
msgstr "%(level)s (manual)"

#. Translators: stats overlay, Buffer row; %(seconds)s is a number like
#. "10.8".
#: static/js/player.js:2237
msgid "%(seconds)s s ahead"
msgstr "%(seconds)s s à frente"

#. Translators: stats overlay, Frames row: dropped frames out of the total
#. decoded so far.
#: static/js/player.js:2244
msgid "%(dropped)s dropped / %(total)s"
