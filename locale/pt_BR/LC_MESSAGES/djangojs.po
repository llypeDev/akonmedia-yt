#: static/js/app.js:221
msgid "Copied to clipboard"
msgstr "Copiado para a área de transferência"

#: static/js/app.js:226
msgid "Could not copy — select the text and copy it manually."
msgstr "Não foi possível copiar — selecione o texto e copie manualmente."

#: static/js/app.js:253
msgid "Show more"
msgstr "Mostrar mais"

#: static/js/app.js:253
msgid "Show less"
msgstr "Mostrar menos"

#: static/js/app.js:299
msgid "pending"
msgstr "na fila"

#: static/js/app.js:300
msgid "processing"
msgstr "processando"

#: static/js/app.js:301
msgid "ready"
msgstr "pronta"

#: static/js/app.js:302
msgid "failed"
msgstr "com falha"

#: static/js/app.js:319
msgid "Processing finished — loading the player."
msgstr "Processamento concluído — carregando o player."

#: static/js/app.js:319
msgid "Processing failed."
msgstr "O processamento falhou."

#. Translators: playback speed 1×, in the player's settings menu.
#: static/js/player.js:181
msgid "Normal"
msgstr "Normal"

#. Translators: automatic quality selection; %(quality)s is the rendition in
#. use, e.g. "720p".
#: static/js/player.js:187
msgid "Auto (%(quality)s)"
msgstr "Auto (%(quality)s)"

#. Translators: automatic quality selection in the player's settings menu.
#: static/js/player.js:190
msgid "Auto"
msgstr "Auto"

#: static/js/player.js:382
msgid "Audio player: %(title)s"
msgstr "Player de áudio: %(title)s"

#: static/js/player.js:382
msgid "Video player: %(title)s"
msgstr "Player de vídeo: %(title)s"

#: static/js/player.js:387
msgid "Audio player"
msgstr "Player de áudio"

#: static/js/player.js:387
msgid "Video player"
msgstr "Player de vídeo"

#: static/js/player.js:475 static/js/player.js:565 static/js/player.js:1177
#: static/js/player.js:1183
msgid "Play"
msgstr "Reproduzir"

#. Translators: embed watermark link; %(site)s is the portal name.
#: static/js/player.js:495
msgid "Open on %(site)s (new tab)"
msgstr "Abrir no %(site)s (nova aba)"

#. Translators: used in "Open on %(site)s (new tab)" when the portal has no
#. name.
#: static/js/player.js:497
msgid "the site"
msgstr "o site"

#. Translators: label of the embed watermark link when the portal has no name.
#: static/js/player.js:502
msgid "Watch"
msgstr "Assistir"

#. Translators: accessible name of the player's seek bar.
#: static/js/player.js:524
msgid "Seek"
msgstr "Barra de progresso"

#. Translators: previous item in a playlist.
#: static/js/player.js:558
msgid "Previous"
msgstr "Anterior"

#. Translators: next item in a playlist.
#: static/js/player.js:574
msgid "Next"
msgstr "Próxima"

#: static/js/player.js:581 static/js/player.js:1247
msgid "Mute"
msgstr "Desativar som"

#: static/js/player.js:592 static/js/player.js:1939
msgid "Volume"
msgstr "Volume"

#: static/js/player.js:613 static/js/player.js:1640 static/js/player.js:1829
#: static/js/player.js:1870
msgid "Subtitles"
msgstr "Legendas"

#: static/js/player.js:622 static/js/player.js:666
msgid "Settings"
msgstr "Configurações"

#: static/js/player.js:634 static/js/player.js:924
msgid "Picture-in-picture"
msgstr "Picture-in-picture"

#: static/js/player.js:643 static/js/player.js:2043
msgid "Theater mode"
msgstr "Modo teatro"

#: static/js/player.js:653 static/js/player.js:2085
msgid "Full screen"
msgstr "Tela cheia"

#: static/js/player.js:790
msgid "This stream could not be loaded."
msgstr "Não foi possível carregar esta transmissão."

#: static/js/player.js:920
msgid "Exit picture-in-picture"
msgstr "Sair do picture-in-picture"

#: static/js/player.js:1108 static/js/player.js:1247
msgid "Unmute"
msgstr "Ativar som"

#. Translators: pill shown after a muted autoplay; also used on desktop.
#: static/js/player.js:1111
msgid "Tap to unmute"
msgstr "Toque para ativar o som"

#. Translators: on-screen flash after skipping, e.g. "+10s" or "−5s"; %(sign)s
#. is + or −, %(seconds)s the amount.
#: static/js/player.js:1153
msgid "%(sign)s%(seconds)ss"
msgstr "%(sign)s%(seconds)ss"

#. Translators: on-screen flash after stepping one video frame forward; keep
#. the arrow.
#: static/js/player.js:1165
msgid "Frame ›"
msgstr "Quadro ›"

#. Translators: on-screen flash after stepping one video frame back; keep the
#. arrow.
#: static/js/player.js:1167
msgid "‹ Frame"
msgstr "‹ Quadro"

#: static/js/player.js:1177 static/js/player.js:1183
msgid "Replay"
msgstr "Assistir de novo"

#: static/js/player.js:1177
msgid "Pause"
msgstr "Pausar"

#. Translators: on-screen flash when the sound is switched off.
#: static/js/player.js:1230
msgid "Muted"
msgstr "Sem som"

#. Translators: spoken value of the seek bar, e.g. "1:05 of 8:15".
#: static/js/player.js:1294
msgid "%(current)s of %(total)s"
msgstr "%(current)s de %(total)s"

#: static/js/player.js:1611
msgid "Subtitles off"
msgstr "Legendas desativadas"

#: static/js/player.js:1617
msgid "Subtitles on"
msgstr "Legendas ativadas"

#. Translators: subtitles switched off, in the player's settings menu.
#: static/js/player.js:1639
msgid "Off"
msgstr "Desativadas"

#: static/js/player.js:1780 static/js/player.js:1851
msgid "Playback speed"
msgstr "Velocidade"

#. Translators: video quality (rendition), in the player's settings menu.
#: static/js/player.js:1793 static/js/player.js:1860
msgid "Quality"
msgstr "Qualidade"

#. Translators: technical overlay with stream statistics (resolution, bitrate,
#. buffer…).
#: static/js/player.js:1880 static/js/player.js:1958
msgid "Stats for nerds"
msgstr "Estatísticas para nerds"

#. Translators: stats overlay row: how the stream is played (HLS via hls.js,
#. native HLS, progressive file).
#: static/js/player.js:1924
msgid "Engine"
msgstr "Mecanismo"

#. Translators: stats overlay row: size of the player on screen.
#: static/js/player.js:1926
msgid "Viewport"
msgstr "Área visível"

#: static/js/player.js:1927
msgid "Resolution"
msgstr "Resolução"

#. Translators: stats overlay row: the HLS rendition being played and its
#. bitrate.
#: static/js/player.js:1929
msgid "Level"
msgstr "Nível"

#: static/js/player.js:1930
msgid "Codecs"
msgstr "Codecs"

#. Translators: stats overlay row: estimated download speed.
#: static/js/player.js:1932
msgid "Bandwidth"
msgstr "Banda"

#. Translators: stats overlay row: how much media is downloaded ahead of the
#. playhead.
#: static/js/player.js:1934
msgid "Buffer"
msgstr "Buffer"

#. Translators: stats overlay row: dropped and total video frames.
#: static/js/player.js:1936
msgid "Frames"
msgstr "Quadros"

#. Translators: stats overlay row: playback speed.
#: static/js/player.js:1938
msgid "Speed"
msgstr "Velocidade"

#. Translators: stats overlay row: current time / duration.
#: static/js/player.js:1941
msgid "Position"
msgstr "Posição"

#: static/js/player.js:1952
msgid "Close stats"
msgstr "Fechar estatísticas"

#. Translators: stats overlay, Engine row: the browser plays HLS by itself.
#: static/js/player.js:1977
msgid "HLS · native"
msgstr "HLS · nativo"

#. Translators: stats overlay, Engine row: the original file, downloaded
#. progressively.
#: static/js/player.js:1980
msgid "Progressive"
msgstr "Progressivo"

#. Translators: stats overlay, Resolution row for sound-only media.
#: static/js/player.js:1986
msgid "audio only"
msgstr "somente áudio"

#. Translators: stats overlay, Level row; %(level)s is e.g. "720p · 2.93 Mbps",
#. chosen automatically.
#: static/js/player.js:1994
msgid "%(level)s (auto)"
msgstr "%(level)s (automático)"

#. Translators: stats overlay, Level row; %(level)s is e.g. "720p · 2.93 Mbps",
#. chosen by the viewer.
#: static/js/player.js:1996
msgid "%(level)s (manual)"
msgstr "%(level)s (manual)"

#. Translators: stats overlay, Buffer row; %(seconds)s is a number like "10.8".
#: static/js/player.js:2005
msgid "%(seconds)s s ahead"
msgstr "%(seconds)s s à frente"

#. Translators: stats overlay, Frames row: dropped frames out of the total
#. decoded so far.
#: static/js/player.js:2012
msgid "%(dropped)s dropped / %(total)s"
msgid_plural "%(dropped)s dropped / %(total)s"
msgstr[0] "%(dropped)s perdido / %(total)s"
msgstr[1] "%(dropped)s perdidos / %(total)s"

#. Translators: stats overlay, Volume row when the sound is off.
#: static/js/player.js:2018
msgid "muted"
msgstr "sem som"

#. Translators: leaves theater mode and returns to the normal page layout.
#: static/js/player.js:2043
msgid "Default view"
msgstr "Visualização padrão"

#: static/js/player.js:2085
msgid "Exit full screen"
msgstr "Sair da tela cheia"

#. Translators: cancels the automatic jump to the next playlist item.
#: static/js/player.js:2129
msgid "Cancel"
msgstr "Cancelar"

#. Translators: plays the next playlist item without waiting for the countdown.
#: static/js/player.js:2133
msgid "Play now"
msgstr "Reproduzir agora"

#. Translators: overlay at the end of a playlist item, before the next one
#. starts.
#: static/js/player.js:2145
msgid "Up next"
msgstr "A seguir"

#. Translators: shown in the "Up next" overlay when the next item has no title.
#: static/js/player.js:2151
msgid "Next item"
msgstr "Próximo item"

#. Translators: button that jumps back to where the viewer stopped; %(time)s is
#. like "4:12".
#: static/js/player.js:2206
msgid "Resume %(time)s"
msgstr "Continuar em %(time)s"

#: static/js/player.js:2208
msgid "Dismiss"
msgstr "Dispensar"

#: static/js/player.js:2220
msgid "Continue where you left off?"
msgstr "Continuar de onde você parou?"

#: static/js/player.js:2275
msgid "Playback was aborted."
msgstr "A reprodução foi interrompida."

#: static/js/player.js:2276
msgid "A network error interrupted the download."
msgstr "Um erro de rede interrompeu o download."

#: static/js/player.js:2277
msgid "The file could not be decoded."
msgstr "Não foi possível decodificar o arquivo."

#: static/js/player.js:2278
msgid "The file is missing or its format is not supported by this browser."
msgstr ""
"O arquivo está ausente ou o formato não é suportado por este navegador."

#: static/js/player.js:2280
msgid "This media could not be played."
msgstr "Não foi possível reproduzir esta mídia."

#: static/js/player.js:2289
msgid "Playback failed"
msgstr "Falha na reprodução"

#: static/js/upload.js:89
msgid "Image"
msgstr "Imagem"

#: static/js/upload.js:90
msgid "Audio"
msgstr "Áudio"

#: static/js/upload.js:91
msgid "Document"
msgstr "Documento"

#: static/js/upload.js:92
msgid "Video"
msgstr "Vídeo"

#: static/js/upload.js:226
msgid "network error"
msgstr "erro de rede"

#: static/js/upload.js:270
msgid "Resuming at chunk %(chunk)s of %(total)s"
msgstr "Retomando na parte %(chunk)s de %(total)s"

#: static/js/upload.js:271
msgid "Sending %(total)s chunk"
msgid_plural "Sending %(total)s chunks"
msgstr[0] "Enviando %(total)s parte"
msgstr[1] "Enviando %(total)s partes"

#: static/js/upload.js:295
msgid "Connection hiccup — retrying chunk %(chunk)s in %(seconds)ss…"
msgstr ""
"A conexão falhou — tentando a parte %(chunk)s de novo em %(seconds)s s…"

#: static/js/upload.js:306
msgid "Finalising"
msgstr "Finalizando"

#: static/js/upload.js:307
msgid "Upload complete — handing the file to the encoder…"
msgstr "Envio concluído — entregando o arquivo ao codificador…"

#: static/js/upload.js:308
msgid ""
"Large videos can take a while: posters, renditions and previews are generated"
" now."
msgstr ""
"Vídeos grandes podem demorar: pôster, versões e prévias estão sendo gerados "
"agora."

#: static/js/upload.js:337
msgid "Uploading"
msgstr "Enviando"

#: static/js/upload.js:343
msgid "Published"
msgstr "Publicada"

#: static/js/upload.js:343
msgid "Processing"
msgstr "Processando"

#: static/js/upload.js:344
msgid "Done — opening your media page."
msgstr "Pronto — abrindo a página da sua mídia."

#: static/js/upload.js:344
msgid "Uploaded. Encoding has started — opening the page."
msgstr "Enviado. A codificação começou — abrindo a página."

#: static/js/upload.js:353
msgid "Cancelled"
msgstr "Cancelado"

#: static/js/upload.js:354
msgid "Upload cancelled."
msgstr "Envio cancelado."

#: static/js/upload.js:360
msgid "Paused"
msgstr "Pausado"

#: static/js/upload.js:361
msgid "The upload stopped: %(reason)s."
msgstr "O envio parou: %(reason)s."

#: static/js/upload.js:361
msgid "unknown error"
msgstr "erro desconhecido"

#: static/js/upload.js:362
msgid ""
"Press “Upload and publish” again to continue from the last confirmed chunk."
msgstr ""
"Aperte “Enviar e publicar” de novo para continuar da última parte confirmada."
